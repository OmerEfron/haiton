{
  "name": "iton-ai-reporter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --env-file=../.env --env-file=.env --experimental-strip-types --test src/run.test.ts src/http/http.test.ts",
    "dev": "node --env-file=../.env --env-file=.env --experimental-strip-types --watch-path=src src/http/listen.ts | pino-pretty",
    "dev:nowatch": "node --env-file=../.env --env-file=.env --experimental-strip-types src/http/listen.ts | pino-pretty",
    "start": "node --experimental-strip-types src/http/listen.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/structured-logger": "^1.0.0",
    "hono": "^4.11.4",
    "openai": "^6.9.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
